 "events": [
  {
   "id": "death-restraint",
   "group": "Deaths",
   "title": "Death that may be linked to restraint, seclusion, psychotropic medicine or suicide",
   "match": "\\b(died|dead|death|passed away|deceased|suicide)\\b.*\\b(restrain|seclu|psychotropic|antipsychotic|suicid)|\\b(suicide)\\b",
   "reports": [
    {
     "to": "e911",
     "clock": {
      "type": "immediate"
     },
     "cite": "",
     "settings": [
      "afh",
      "cbrf"
     ],
     "status": "verified",
     "required": true,
     "note": "If anyone may still be helped."
    },
    {
     "to": "dqa_death",
     "clock": {
      "type": "hours",
      "n": 24
     },
     "cite": "DHS 83.12(1)(a); DQA P-02007",
     "settings": [
